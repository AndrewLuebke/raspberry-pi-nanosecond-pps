+/* ================================================== */
+
+/* Report-line time with an auto-scaled unit: whole picoseconds, then three
+   decimals of ns/us/ms/s (the command protocol carries ~7 significant digits) */
+
+static void
+print_time_human(double s, int sign)
+{
+  double x = fabs(s);
+
+  if (x < 999.5e-12) {
+    printf(sign ? "%+.0f ps" : "%.0f ps", s * 1e12);
+  } else if (x < 999.5e-9) {
+    printf(sign ? "%+.3f ns" : "%.3f ns", s * 1e9);
+  } else if (x < 999.5e-6) {
+    printf(sign ? "%+.3f us" : "%.3f us", s * 1e6);
+  } else if (x < 999.5e-3) {
+    printf(sign ? "%+.3f ms" : "%.3f ms", s * 1e3);
+  } else {
+    printf(sign ? "%+.3f s" : "%.3f s", s);
+  }
+}
+
+/* ================================================== */
+
+/* Report-line frequency with an auto-scaled unit: whole ppt, then three
+   decimals of ppb/ppm */
+
+static void
+print_freq_human(double f, int sign)
+{
+  double x = fabs(f);
+
+  if (x < 999.5e-6) {
+    printf(sign ? "%+.0f ppt" : "%.0f ppt", f * 1e6);
+  } else if (x < 999.5e-3) {
+    printf(sign ? "%+.3f ppb" : "%.3f ppb", f * 1e3);
+  } else {
+    printf(sign ? "%+.3f ppm" : "%.3f ppm", f);
   }
 }
 
